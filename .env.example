# Copy this file to `.env` and fill in your values.

# Password for /admin (CHANGE THIS before going live)
ADMIN_PASSWORD=change-me-now

# Flight provider: auto | duffel | travelpayouts | demo
#   auto = Duffel if a token is set, else Travelpayouts, else demo fares
FLIGHT_PROVIDER=auto

# Duffel (free test mode: https://duffel.com -> sign up -> Developers -> Access tokens)
# Test tokens start with duffel_test_ and return real airline schedules in sandbox mode.
DUFFEL_ACCESS_TOKEN=

# Travelpayouts / Aviasales Data API (free: https://www.travelpayouts.com -> Tools -> API)
# Cached real fares + affiliate booking links (you earn commission on bookings).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Server
PORT=8000
# Use 0.0.0.0 to accept connections from other devices / on a server
HOST=127.0.0.1
