# OK Travel & Tourism — Apache / LiteSpeed (Hostinger) configuration

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the site lives in a subfolder (e.g. example.com/travel), set: RewriteBase /travel/
  RewriteBase /

  # Never serve private folders, dotfiles or backups directly.
  RewriteRule ^(app|storage|_legacy_python_version)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sqlite|sql|log|bak|env|ini|sh|md|json\.bak)$ - [F,L,NC]

  # Redirect www to the bare domain (uncomment to enable; HTTPS is enforced from Admin → Settings → System).
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Everything that is not a real file goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Block direct access to sensitive files even if mod_rewrite is off.
<FilesMatch "(^\.|\.(sqlite|sql|log|bak|env|ini|sh)$|^composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security headers for static files (PHP pages send their own).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Browser caching. CSS/JS URLs carry a version (?v=…) so they can be cached for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

# Upload limits for the image library (ignored where the host does not allow php_value).
<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 64M
</IfModule>
